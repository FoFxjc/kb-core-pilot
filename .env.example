# kb-core settings. Copy to .env (never commit it) or set them in the service environment.
# Only KB_CORE_* names are read; variables already set in the environment win over this file.
# Every KB_CORE_* name the code reads is listed here (a test checks it). Values below are placeholders.

# ---------- environment ----------
# development | production (default development). Production refuses: auth mode none, the test clock, key
# variables outside KB_CORE_*.
KB_CORE_ENV=production

# ---------- Postgres (authoritative store) ----------
# Any libpq connection string. TLS: sslmode=verify-full with the company CA (sslrootcert) checks the server name.
KB_CORE_PG_DSN=postgresql://kbcore@db.example.internal:5432/kbcore?sslmode=verify-full&sslrootcert=/etc/kb-core/tls/company-ca.pem
# The password goes in the DSN, in a libpq password file (PGPASSFILE) or in the service manager's secret store.

# ---------- Elasticsearch (rebuildable index; 7.10 to 8.x, no plugins) ----------
KB_CORE_ES_URL=https://es.example.internal:9200
# Basic auth, or an API key (base64 "id:key"), and the CA bundle of the company certificate authority.
# KB_CORE_ES_USER=
# KB_CORE_ES_PASSWORD=
# KB_CORE_ES_API_KEY=
KB_CORE_ES_CA_CERTS=/etc/kb-core/tls/company-ca.pem
# Prefix of every index and alias name (lowercase; follow the company naming rules).
KB_CORE_INDEX_PREFIX=kbcore_

# ---------- folders ----------
# Where kb-intake delivers packages (read-only for kb-core). Required; there is no default.
KB_CORE_DELIVERY_DIR=/srv/kb-intake/delivery
# Imported packages (read-only copies), page image cache and the model-call ledger.
KB_CORE_STORE_DIR=/srv/kb-core/store

# ---------- interpretation ----------
# Domain pack under domains/.
KB_CORE_DOMAIN=banking

# ---------- identity (docs/deploy.md: the SSO gateway) ----------
# none (development only: no identity, demo roles via X-KB-Subject) | trusted_header (production).
KB_CORE_AUTH_MODE=trusted_header
# Headers the SSO gateway sets after it authenticates the user; the gateway must strip them from client requests.
KB_CORE_AUTH_USER_HEADER=X-Auth-User
# Comma-separated group names; mapped to roles in config/access_role_map.yaml.
KB_CORE_AUTH_GROUPS_HEADER=X-Auth-Groups

# ---------- access control ----------
# Defaults: config/access_labels.yaml, config/access_roles.yaml, config/access_role_map.yaml.
# KB_CORE_ACCESS_LABELS=/etc/kb-core/access_labels.yaml
# KB_CORE_ACCESS_ROLES=/etc/kb-core/access_roles.yaml
# KB_CORE_ACCESS_ROLE_MAP=/etc/kb-core/access_role_map.yaml

# ---------- model endpoints (chat-completions-compatible HTTP APIs; every purpose is off by default) ----------
# The default endpoint; each purpose below falls back to it setting by setting.
# KB_CORE_LLM_BASE_URL=https://llm-gateway.example.internal/v1
# KB_CORE_LLM_MODEL=model-name
# The key: KB_CORE_LLM_API_KEY, or name another KB_CORE_* variable that holds it with KB_CORE_LLM_API_KEY_VAR.
# KB_CORE_LLM_API_KEY=
# KB_CORE_LLM_API_KEY_VAR=KB_CORE_LLM_API_KEY
# CA bundle for the endpoint (default: the system store) and seconds per call.
# KB_CORE_LLM_CA_CERTS=/etc/kb-core/tls/company-ca.pem
# KB_CORE_LLM_TIMEOUT_S=60
# Outbound proxy: the standard HTTPS_PROXY / NO_PROXY variables of the process are honoured by every model client.

# Live chat (POST /v1/admin/chat).
KB_CORE_CHAT_ENABLED=false
# KB_CORE_CHAT_BASE_URL=
# KB_CORE_CHAT_MODEL=
# KB_CORE_CHAT_API_KEY_VAR=     (default: the default endpoint's key variable)
# KB_CORE_CHAT_CA_CERTS=
# KB_CORE_CHAT_TIMEOUT_S=120
# Tool calls per chat session (counted across turns) and output tokens per model call.
# KB_CORE_CHAT_MAX_TOOL_CALLS=8
# KB_CORE_CHAT_MAX_TOKENS=4096
# Optional cap on all chat model calls (counted from <store>/chat/model_calls.jsonl); unset means no cap.
# KB_CORE_CHAT_BUDGET_CALLS=

# The judge (decision plane inside retrieval; implemented in round 3: configuration only for now).
KB_CORE_JUDGE_ENABLED=false
# KB_CORE_JUDGE_BASE_URL=
# KB_CORE_JUDGE_MODEL=
# KB_CORE_JUDGE_API_KEY_VAR=     (default: the default endpoint's key variable)
# KB_CORE_JUDGE_CA_CERTS=
# KB_CORE_JUDGE_TIMEOUT_S=30
# KB_CORE_JUDGE_MAX_CALLS_PER_QUERY=2

# Graph extraction (seed proof of concept; outside the retrieval path).
KB_CORE_EXTRACT_ENABLED=false
# KB_CORE_EXTRACT_BASE_URL=
# KB_CORE_EXTRACT_MODEL=
# KB_CORE_EXTRACT_API_KEY_VAR=     (default: the default endpoint's key variable)
# KB_CORE_EXTRACT_CA_CERTS=
# KB_CORE_EXTRACT_TIMEOUT_S=120

# ---------- serve ----------
# Bind to loopback or a private interface reachable only from the SSO gateway (docs/deploy.md).
KB_CORE_HOST=127.0.0.1
KB_CORE_PORT=8200

# ---------- evaluation switches (leave unset in service) ----------
# Coverage threshold override for threshold sweeps (default: config/ranking.yaml).
# KB_CORE_COVERAGE_THRESHOLD=
# on | off: query aliases and synonyms (ablation runs only).
# KB_CORE_ALIASES=on

# ---------- repository tools ----------
# scripts/check_contract.py: a checkout of the kb-intake repository to compare the contract copy with (required).
# KB_CORE_INTAKE_REPO=/path/to/kb-intake

# =====================================================================================================================
# Test-only settings: NEVER IN PRODUCTION
# =====================================================================================================================
# Test clock (development only; production refuses to start with either set).
# KB_CORE_ALLOW_CLOCK_OVERRIDE=false
# KB_CORE_NOW=2026-01-01T00:00:00+00:00
# Integration tests: point them at your own throwaway Postgres database and Elasticsearch clusters (docs/deploy.md).
# KB_CORE_TEST_PG_DSN=postgresql://kbcore_test@db.example.internal:5432/kbcore_test
# KB_CORE_TEST_ES_URL=https://es-test.example.internal:9200
# KB_CORE_TEST_ES7_URL=https://es7-test.example.internal:9200
# Web end-to-end tests (web/playwright.config.ts): the running kb-core to test against.
# KB_CORE_UI_BASE=https://kb-core-test.example.internal
