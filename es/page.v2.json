{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "kb_ws": {
          "type": "custom",
          "tokenizer": "whitespace",
          "filter": [
            "lowercase"
          ]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "doc_id": {
        "type": "keyword"
      },
      "page_no": {
        "type": "integer"
      },
      "page_label": {
        "type": "keyword"
      },
      "fiscal_year": {
        "type": "integer"
      },
      "lang": {
        "type": "keyword"
      },
      "issuer": {
        "type": "keyword"
      },
      "text": {
        "type": "text",
        "index": false
      },
      "text_tok": {
        "type": "text",
        "analyzer": "kb_ws"
      },
      "access_classification": {
        "type": "keyword"
      },
      "access_domains": {
        "type": "keyword"
      },
      "access_embargo_until": {
        "type": "date"
      }
    }
  }
}
